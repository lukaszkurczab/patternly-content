{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-track-brief-v1",
  "title": "Patternly canonical track brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trackId",
    "jobToBeDone",
    "targetLearner",
    "internalFamily",
    "taxonomyOutline",
    "freeNodeId",
    "validModes",
    "goalTemplates",
    "progressDimensions",
    "packageContentPlan",
    "launchCommercialGate"
  ],
  "properties": {
    "schemaVersion": {
      "const": "patternly-track-brief-v1"
    },
    "trackId": {
      "enum": [
        "coding-interview-dsa-problem-solving",
        "backend-system-design-interview",
        "object-oriented-design-interview",
        "frontend-system-design-interview",
        "google-cloud-associate-cloud-engineer",
        "aws-certified-solutions-architect-associate",
        "microsoft-azure-administrator-associate-az-104",
        "microsoft-azure-ai-fundamentals-ai-901",
        "hashicorp-terraform-associate-004",
        "kubernetes-cloud-native-associate-kcna"
      ]
    },
    "jobToBeDone": {
      "type": "string",
      "minLength": 1
    },
    "targetLearner": {
      "type": "string",
      "minLength": 1
    },
    "internalFamily": {
      "enum": [
        "certification",
        "coding_interview",
        "design_interview"
      ]
    },
    "taxonomyOutline": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "freeNodeId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "validModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "goalTemplates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "prepare_for_a_certification",
          "prepare_for_an_interview",
          "build_foundations",
          "refresh_and_maintain_skills",
          "learn_at_own_pace"
        ]
      }
    },
    "progressDimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_]*$"
      }
    },
    "packageContentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundledFreeNodeId",
        "premiumPackageUnit",
        "contentScopes",
        "provenanceRules"
      ],
      "properties": {
        "bundledFreeNodeId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "premiumPackageUnit": {
          "const": "immutableCompressedWholeNodePackage"
        },
        "contentScopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenanceRules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "launchCommercialGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productionRegistryAdmission"
      ],
      "properties": {
        "productionRegistryAdmission": {
          "const": "realFreeVerticalAndCompleteCoreLoop"
        }
      }
    }
  }
}
