{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-human-content-approval-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "sourceCommit",
    "approver",
    "confirmationDate",
    "reviewScope",
    "tracks",
    "acceptedLimitations",
    "finalDisposition"
  ],
  "properties": {
    "schemaVersion": { "const": "patternly-human-content-approval-manifest-v1" },
    "decisionId": { "type": "string", "minLength": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "confirmationSource"],
      "properties": {
        "kind": { "const": "human_owner" },
        "id": { "type": "string", "minLength": 1 },
        "confirmationSource": { "const": "owner_confirmation_in_active_conversation" }
      }
    },
    "confirmationDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "reviewScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tracks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approvalId",
          "trackId",
          "familyId",
          "sourceCommit",
          "sourceRoot",
          "sourceManifestSha256",
          "itemManifestSha256",
          "sourceFileCount",
          "canonicalItemCount",
          "reviewPacketPath",
          "reviewPacketSourceCommit",
          "reviewPacketSampleCount"
        ],
        "properties": {
          "approvalId": { "type": "string", "minLength": 1 },
          "trackId": { "type": "string", "minLength": 1 },
          "familyId": { "type": "string", "minLength": 1 },
          "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "sourceRoot": { "type": "string", "minLength": 1 },
          "sourceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "itemManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceFileCount": { "type": "integer", "minimum": 1 },
          "canonicalItemCount": { "type": "integer", "minimum": 1 },
          "reviewPacketPath": { "type": "string", "minLength": 1 },
          "reviewPacketSourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "reviewPacketSampleCount": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "acceptedLimitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "finalDisposition": { "const": "approved" }
  }
}
