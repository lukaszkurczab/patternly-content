{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-family-authoring-registration-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "familyId",
    "sourceSchemaPath",
    "supportedAuthoringInteractions",
    "semanticValidatorId",
    "pathPolicyId",
    "sourceAdmissionRule",
    "feedbackRequirements",
    "provenanceRequirements",
    "runtimePublicationRelationship"
  ],
  "properties": {
    "schemaVersion": { "const": "patternly-family-authoring-registration-v1" },
    "familyId": { "type": "string", "minLength": 1 },
    "sourceSchemaPath": { "type": "string", "minLength": 1 },
    "supportedAuthoringInteractions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interactionType", "selectionModels"],
        "properties": {
          "interactionType": { "type": "string", "minLength": 1 },
          "selectionModels": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "semanticValidatorId": { "type": "string", "minLength": 1 },
    "pathPolicyId": { "type": "string", "minLength": 1 },
    "sourceAdmissionRule": { "type": "string", "minLength": 1 },
    "feedbackRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "provenanceRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "runtimePublicationRelationship": { "type": "string", "minLength": 1 }
  }
}
