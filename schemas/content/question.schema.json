{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternly.dev/schemas/content/question-v1.json",
  "title": "Patternly canonical question v1",
  "description": "Family-neutral question contract. The five oneOf branches are intentionally disjoint by interaction.type.",
  "type": "object",
  "properties": {
    "questionId": { "$ref": "#/$defs/id" },
    "trackId": { "$ref": "#/$defs/id" },
    "nodeId": { "$ref": "#/$defs/id" },
    "mentalUnitId": { "$ref": "#/$defs/id" },
    "prompt": { "$ref": "#/$defs/nonEmptyText" },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyText" }
    },
    "interaction": { "type": "object" },
    "answer": { "type": "object" },
    "feedback": { "type": "object" },
    "difficulty": { "$ref": "#/$defs/nonEmptyText" },
    "sourceRefs": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyText" }
    }
  },
  "required": [
    "questionId",
    "trackId",
    "nodeId",
    "mentalUnitId",
    "prompt",
    "constraints",
    "interaction",
    "answer",
    "feedback",
    "difficulty",
    "sourceRefs"
  ],
  "additionalProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/choiceSingleQuestion" },
    { "$ref": "#/$defs/choiceMultipleQuestion" },
    { "$ref": "#/$defs/orderingQuestion" },
    { "$ref": "#/$defs/complexityQuestion" },
    { "$ref": "#/$defs/decisionMatrixQuestion" }
  ],
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "option": {
      "type": "object",
      "properties": {
        "optionId": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/nonEmptyText" }
      },
      "required": ["optionId", "text"],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "elementId": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/nonEmptyText" }
      },
      "required": ["elementId", "text"],
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "properties": {
        "valueId": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/nonEmptyText" }
      },
      "required": ["valueId", "text"],
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "properties": {
        "dimensionId": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/nonEmptyText" },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/value" }
        },
        "acceptedValueIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "required": ["dimensionId", "label", "values", "acceptedValueIds"],
      "additionalProperties": false
    },
    "textMap": {
      "type": "object",
      "propertyNames": { "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
      "additionalProperties": { "$ref": "#/$defs/nonEmptyText" }
    },
    "selectedValueMap": {
      "type": "object",
      "propertyNames": { "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "questionBase": {
      "type": "object",
      "properties": {
        "questionId": { "$ref": "#/$defs/id" },
        "trackId": { "$ref": "#/$defs/id" },
        "nodeId": { "$ref": "#/$defs/id" },
        "mentalUnitId": { "$ref": "#/$defs/id" },
        "prompt": { "$ref": "#/$defs/nonEmptyText" },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyText" }
        },
        "interaction": { "type": "object" },
        "answer": { "type": "object" },
        "feedback": { "type": "object" },
        "difficulty": { "$ref": "#/$defs/nonEmptyText" },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyText" }
        }
      },
      "required": [
        "questionId",
        "trackId",
        "nodeId",
        "mentalUnitId",
        "prompt",
        "constraints",
        "interaction",
        "answer",
        "feedback",
        "difficulty",
        "sourceRefs"
      ]
    },
    "choiceSingleInteraction": {
      "type": "object",
      "properties": {
        "type": { "const": "choice_single" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" }
        }
      },
      "required": ["type", "options"],
      "additionalProperties": false
    },
    "choiceMultipleInteraction": {
      "type": "object",
      "properties": {
        "type": { "const": "choice_multiple" },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/option" }
        }
      },
      "required": ["type", "options"],
      "additionalProperties": false
    },
    "orderingInteraction": {
      "type": "object",
      "properties": {
        "type": { "const": "ordering" },
        "elements": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/element" }
        }
      },
      "required": ["type", "elements"],
      "additionalProperties": false
    },
    "complexityInteraction": {
      "type": "object",
      "properties": {
        "type": { "const": "complexity" },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dimension" }
        }
      },
      "required": ["type", "dimensions"],
      "additionalProperties": false
    },
    "decisionMatrixInteraction": {
      "type": "object",
      "properties": {
        "type": { "const": "decision_matrix" },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dimension" }
        }
      },
      "required": ["type", "dimensions"],
      "additionalProperties": false
    },
    "choiceSingleAnswer": {
      "type": "object",
      "properties": {
        "type": { "const": "choice_single" },
        "optionId": { "$ref": "#/$defs/id" }
      },
      "required": ["type", "optionId"],
      "additionalProperties": false
    },
    "choiceMultipleAnswer": {
      "type": "object",
      "properties": {
        "type": { "const": "choice_multiple" },
        "optionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "required": ["type", "optionIds"],
      "additionalProperties": false
    },
    "orderingAnswer": {
      "type": "object",
      "properties": {
        "type": { "const": "ordering" },
        "orderedElementIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "required": ["type", "orderedElementIds"],
      "additionalProperties": false
    },
    "dimensionAnswer": {
      "type": "object",
      "properties": {
        "type": { "enum": ["complexity", "decision_matrix"] },
        "selectedValueIdsByDimension": { "$ref": "#/$defs/selectedValueMap" }
      },
      "required": ["type", "selectedValueIdsByDimension"],
      "additionalProperties": false
    },
    "choiceSingleFeedback": {
      "type": "object",
      "properties": {
        "type": { "const": "choice_single" },
        "correct": { "$ref": "#/$defs/nonEmptyText" },
        "incorrectByOptionId": { "$ref": "#/$defs/textMap" }
      },
      "required": ["type", "correct", "incorrectByOptionId"],
      "additionalProperties": false
    },
    "choiceMultipleFeedback": {
      "type": "object",
      "properties": {
        "type": { "const": "choice_multiple" },
        "correct": { "$ref": "#/$defs/nonEmptyText" },
        "incorrectByOptionId": { "$ref": "#/$defs/textMap" },
        "omittedByOptionId": { "$ref": "#/$defs/textMap" }
      },
      "required": ["type", "correct", "incorrectByOptionId", "omittedByOptionId"],
      "additionalProperties": false
    },
    "orderingFeedback": {
      "type": "object",
      "properties": {
        "type": { "const": "ordering" },
        "correct": { "$ref": "#/$defs/nonEmptyText" },
        "incorrectByElementId": { "$ref": "#/$defs/textMap" },
        "brokenByRelationId": { "$ref": "#/$defs/textMap" }
      },
      "required": ["type", "correct", "incorrectByElementId", "brokenByRelationId"],
      "additionalProperties": false
    },
    "dimensionFeedback": {
      "type": "object",
      "properties": {
        "type": { "enum": ["complexity", "decision_matrix"] },
        "correct": { "$ref": "#/$defs/nonEmptyText" },
        "incorrectByDimensionIdAndValueId": { "$ref": "#/$defs/textMap" },
        "omittedByDimensionId": { "$ref": "#/$defs/textMap" }
      },
      "required": ["type", "correct", "incorrectByDimensionIdAndValueId", "omittedByDimensionId"],
      "additionalProperties": false
    },
    "choiceSingleQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        {
          "type": "object",
          "properties": {
            "interaction": { "$ref": "#/$defs/choiceSingleInteraction" },
            "answer": { "$ref": "#/$defs/choiceSingleAnswer" },
            "feedback": { "$ref": "#/$defs/choiceSingleFeedback" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "choiceMultipleQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        {
          "type": "object",
          "properties": {
            "interaction": { "$ref": "#/$defs/choiceMultipleInteraction" },
            "answer": { "$ref": "#/$defs/choiceMultipleAnswer" },
            "feedback": { "$ref": "#/$defs/choiceMultipleFeedback" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "orderingQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        {
          "type": "object",
          "properties": {
            "interaction": { "$ref": "#/$defs/orderingInteraction" },
            "answer": { "$ref": "#/$defs/orderingAnswer" },
            "feedback": { "$ref": "#/$defs/orderingFeedback" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "complexityQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        {
          "type": "object",
          "properties": {
            "interaction": { "$ref": "#/$defs/complexityInteraction" },
            "answer": {
              "allOf": [
                { "$ref": "#/$defs/dimensionAnswer" },
                { "properties": { "type": { "const": "complexity" } } }
              ]
            },
            "feedback": {
              "allOf": [
                { "$ref": "#/$defs/dimensionFeedback" },
                { "properties": { "type": { "const": "complexity" } } }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "decisionMatrixQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        {
          "type": "object",
          "properties": {
            "interaction": { "$ref": "#/$defs/decisionMatrixInteraction" },
            "answer": {
              "allOf": [
                { "$ref": "#/$defs/dimensionAnswer" },
                { "properties": { "type": { "const": "decision_matrix" } } }
              ]
            },
            "feedback": {
              "allOf": [
                { "$ref": "#/$defs/dimensionFeedback" },
                { "properties": { "type": { "const": "decision_matrix" } } }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
