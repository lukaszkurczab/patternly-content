{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-content-candidate-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "baseline",
    "canonicalRepresentation",
    "tracks"
  ],
  "properties": {
    "schemaVersion": { "const": "patternly-content-candidate-manifest-v1" },
    "candidateId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "evidence/content-acceptance/acc-01-baseline-v1.json" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "canonicalRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalJsonVersion", "trackOrder", "candidateId"],
      "properties": {
        "canonicalJsonVersion": { "const": "canonical-json-v1" },
        "trackOrder": { "const": "ascending-track-id" },
        "candidateId": { "const": "sha256(canonicalJson(identity-payload-without-candidateId))" }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trackId", "familyId", "source", "artifact"],
        "properties": {
          "trackId": { "type": "string", "minLength": 1 },
          "familyId": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceCommit",
              "sourceRoot",
              "sourceFileCount",
              "canonicalItemCount",
              "sourceManifestSha256",
              "itemManifestSha256"
            ],
            "properties": {
              "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "sourceRoot": { "type": "string", "minLength": 1 },
              "contentVersion": { "type": "string", "minLength": 1 },
              "sourceFileCount": { "type": "integer", "minimum": 1 },
              "canonicalItemCount": { "type": "integer", "minimum": 1 },
              "sourceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "itemManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trackId",
              "releaseId",
              "releasePath",
              "contentVersion",
              "taxonomyVersion",
              "sourceRepositoryCommit",
              "checksumSha256"
            ],
            "properties": {
              "trackId": { "type": "string", "minLength": 1 },
              "releaseId": { "type": "string", "minLength": 1 },
              "releasePath": { "type": "string", "minLength": 1 },
              "contentVersion": { "type": "string", "minLength": 1 },
              "taxonomyVersion": { "type": "string", "minLength": 1 },
              "sourceRepositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "checksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
