{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decisionId", "decisionAuthority", "taskId", "decision", "decisionRationale", "candidatePath", "candidateId", "sourceRepositoryCommit", "release", "trackIds", "tracks", "basis", "boundaries"],
  "properties": {
    "schemaVersion": { "const": "patternly-content-candidate-decision-v2" },
    "decisionId": { "type": "string", "minLength": 1 },
    "decisionAuthority": { "const": "delegated_codex" },
    "taskId": { "const": "AWS-02/CANDIDATE" },
    "decision": { "const": "approved_for_candidate_readiness" },
    "decisionRationale": { "type": "string", "minLength": 1 },
    "candidatePath": { "const": "reports/candidate-reconciliation/AWS-02-DRAFT/candidate/manifest.json" },
    "candidateId": { "type": "string", "minLength": 64 },
    "sourceRepositoryCommit": { "type": "string", "minLength": 40 },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseId", "releasePath", "checksumSha256"],
      "properties": {
        "releaseId": { "type": "string", "minLength": 1 },
        "releasePath": { "const": "reports/candidate-reconciliation/AWS-02-DRAFT/release/release.json" },
        "checksumSha256": { "type": "string", "minLength": 64 }
      }
    },
    "trackIds": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "string" } },
    "tracks": { "type": "array", "minItems": 9, "maxItems": 9, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["trackId", "sourcePath", "artifactPath", "questionCount", "questionSetSha256", "artifactSha256"],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "artifactPath": { "type": "string", "minLength": 1 },
        "questionCount": { "type": "integer" },
        "questionSetSha256": { "type": "string", "minLength": 64 },
        "artifactSha256": { "type": "string", "minLength": 64 }
      }
    } },
    "basis": {
      "type": "object", "additionalProperties": false,
      "required": ["odk096", "nineTrackBuild", "repositoryTests", "migrationVerification"],
      "properties": {
        "odk096": { "const": "passed" },
        "nineTrackBuild": { "const": "passed" },
        "repositoryTests": { "const": "passed" },
        "migrationVerification": { "const": "passed" }
      }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["publishingAdmission", "runtimeAdmission", "appReleaseLockUpdated"],
      "properties": {
        "publishingAdmission": { "const": "not_granted" },
        "runtimeAdmission": { "const": "not_granted" },
        "appReleaseLockUpdated": { "const": false }
      }
    }
  }
}
