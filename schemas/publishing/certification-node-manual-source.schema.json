{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "certification-node-manual-source-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batchId", "trackId", "familyId", "contentVersion", "taxonomyVersion", "nodeId", "learningBlockIds", "slotIds", "items", "authoringProvenance"],
  "properties": {
    "schemaVersion": { "const": "certification-node-manual-source-v1" },
    "batchId": { "type": "string", "minLength": 1 },
    "trackId": { "type": "string", "minLength": 1 },
    "familyId": { "const": "certification" },
    "contentVersion": { "type": "string", "minLength": 1 },
    "taxonomyVersion": { "type": "string", "minLength": 1 },
    "nodeId": { "type": "string", "minLength": 1 },
    "learningBlockIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "slotIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "authoringProvenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoringMethod", "approvalStatus", "author", "createdAt", "contentBatchId"],
      "properties": {
        "authoringMethod": { "const": "manual" },
        "approvalStatus": { "const": "unapproved" },
        "author": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "minLength": 1 },
        "contentBatchId": { "type": "string", "minLength": 1 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["optionId", "text"],
      "properties": { "optionId": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 } }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "selectionMode", "options", "acceptedOptionIds"],
      "properties": {
        "type": { "const": "choice" },
        "selectionMode": { "const": "single" },
        "options": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/option" } },
        "acceptedOptionIds": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanismOrProperty", "scenarioApplication", "errorCorrection", "boundaryOrTradeoff", "transfer", "url"],
      "properties": {
        "mechanismOrProperty": { "type": "string", "minLength": 1 },
        "scenarioApplication": { "type": "string", "minLength": 1 },
        "errorCorrection": { "type": "string", "minLength": 1 },
        "boundaryOrTradeoff": { "type": "string", "minLength": 1 },
        "transfer": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://learn\\.microsoft\\.com/[^\\s]+$" }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Reason", "Details", "wrongOptionExplanationsByOptionId", "omittedCorrectElementExplanationsByOptionId"],
      "properties": {
        "Reason": { "type": "string", "minLength": 1 },
        "Details": { "$ref": "#/$defs/details" },
        "wrongOptionExplanationsByOptionId": { "type": "object", "minProperties": 3, "additionalProperties": { "type": "string", "minLength": 1 } },
        "omittedCorrectElementExplanationsByOptionId": { "type": "object", "maxProperties": 0 }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "claimIds", "anchorIds", "sourceRefs"],
      "properties": {
        "bindingId": { "type": "string", "minLength": 1 },
        "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "anchorIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "slotId", "nodeId", "learningBlockId", "taxonomy", "prompt", "constraints", "interaction", "scoringContract", "feedback", "modeEligibility", "sourceBinding", "authoringProvenance"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "slotId": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "learningBlockId": { "type": "string", "minLength": 1 },
        "taxonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["examDomainId", "competencyAreaId", "topicId", "skillAtomId"],
          "properties": {
            "examDomainId": { "type": "string", "minLength": 1 },
            "competencyAreaId": { "type": "string", "minLength": 1 },
            "topicId": { "type": "string", "minLength": 1 },
            "skillAtomId": { "type": "string", "minLength": 1 }
          }
        },
        "prompt": { "type": "string", "minLength": 1 },
        "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "interaction": { "$ref": "#/$defs/interaction" },
        "scoringContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "resultSemantics", "selectionMode"],
          "properties": { "type": { "const": "choice" }, "resultSemantics": { "const": "exact_selected_set_with_partial_v1" }, "selectionMode": { "const": "single" } }
        },
        "feedback": { "$ref": "#/$defs/feedback" },
        "modeEligibility": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "sourceBinding": { "$ref": "#/$defs/sourceBinding" },
        "authoringProvenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
