{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundled-free-node-v1",
  "title": "Patternly bundled complete Free node",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifest", "payload"],
  "properties": {
    "schemaVersion": { "const": "bundled-free-node-v1" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleKind", "trackId", "familyId", "freeNodeId", "contentVersion", "taxonomyVersion", "itemCount", "modeIds", "assetCount", "payloadSchemaVersion", "payloadCanonicalSha256", "provenance"],
      "properties": {
        "bundleKind": { "const": "bundled_free_node" },
        "trackId": { "type": "string", "minLength": 1 },
        "familyId": { "enum": ["certification", "coding_interview"] },
        "freeNodeId": { "type": "string", "minLength": 1 },
        "contentVersion": { "type": "string", "minLength": 1 },
        "taxonomyVersion": { "type": "string", "minLength": 1 },
        "itemCount": { "type": "integer", "minimum": 1 },
        "modeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "assetCount": { "type": "integer", "minimum": 0 },
        "payloadSchemaVersion": { "const": "bundled-free-node-payload-v1" },
        "payloadCanonicalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseId", "sourceRepositoryCommit", "sourceArtifactSchemaVersion", "sourceArtifactChecksumSha256", "inventorySchemaVersion", "inventoryCanonicalSha256", "trackBriefSchemaVersion", "trackBriefCanonicalSha256"],
          "properties": {
            "releaseId": { "type": "string", "minLength": 1 },
            "sourceRepositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "sourceArtifactSchemaVersion": { "const": "published-bank-v1" },
            "sourceArtifactChecksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "inventorySchemaVersion": { "const": "patternly-free-node-inventory-v1" },
            "inventoryCanonicalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "trackBriefSchemaVersion": { "const": "patternly-track-brief-v1" },
            "trackBriefCanonicalSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "trackId", "familyId", "freeNodeId", "contentVersion", "taxonomyVersion", "modeStructures", "assets", "items"],
      "properties": {
        "schemaVersion": { "const": "bundled-free-node-payload-v1" },
        "trackId": { "type": "string", "minLength": 1 },
        "familyId": { "enum": ["certification", "coding_interview"] },
        "freeNodeId": { "type": "string", "minLength": 1 },
        "contentVersion": { "type": "string", "minLength": 1 },
        "taxonomyVersion": { "type": "string", "minLength": 1 },
        "modeStructures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "practiceBlueprints": { "type": "array", "items": { "type": "object" } },
            "recognitionSets": { "type": "array", "items": { "type": "object" } },
            "contrastSets": { "type": "array", "items": { "type": "object" } },
            "interleavedScopes": { "type": "array", "items": { "type": "object" } },
            "compatibilitySets": { "type": "array", "items": { "type": "object" } },
            "simulationPools": { "type": "array", "items": { "type": "object" } },
            "simulationProfiles": { "type": "array", "items": { "type": "object" } },
            "diagnosticBaseline": { "type": "object" },
            "focusPractice": { "type": "object" },
            "scenarioPractice": { "type": "object" },
            "weakAreaReview": { "type": "object" },
            "mixedPractice": { "type": "object" },
            "quickReview": { "type": "object" },
            "examExperienceProfile": { "type": "object" }
          }
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sourcePath", "sha256"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "sourcePath": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "items": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object" } }
      }
    }
  }
}
