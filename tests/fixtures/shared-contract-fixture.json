  "questions": [
    {
      "questionId": "simp01-choice-single",
      "trackId": "coding-interview-dsa-problem-solving",
      "nodeId": "simp01-interactions",
      "mentalUnitId": "simp01-choice-single-unit",
      "prompt": "Which boundary should own the durable result?",
      "constraints": ["Choose exactly one option.", "The owner must be authoritative."] ,
      "interaction": {
        "type": "choice_single",
        "scoringMethod": "exact_selected_set",
        "options": [
          { "optionId": "service", "text": "The authoritative service", "explanation": "It is the owner that can enforce durable truth." },
          { "optionId": "screen", "text": "The rendering screen" },
          { "optionId": "cache", "text": "An unverified local cache" }
        ]
      },
      "answer": {
        "type": "choice_single",
        "optionId": "service"
      },
      "feedback": {
        "type": "choice_single",
        "reason": "The authoritative service owns durable truth.",
        "details": {},
        "messages": [
          { "kind": "wrong_option", "targetId": "screen", "text": "A screen cannot be the durable owner." },
          { "kind": "wrong_option", "targetId": "cache", "text": "An unverified cache cannot establish durable truth." }
        ]
      },
      "difficulty": "foundational",
      "sourceRefs": ["fixture://simp-01/choice-single"]
    },
    {
      "questionId": "simp01-choice-multiple",
      "trackId": "coding-interview-dsa-problem-solving",
      "nodeId": "simp01-interactions",
      "mentalUnitId": "simp01-choice-multiple-unit",
      "prompt": "Select every measure that makes a retry safe and observable.",
      "constraints": ["There can be more than one correct option.", "Do not select an unsafe fallback."],
      "interaction": {
        "type": "choice_multiple",
        "scoringMethod": "exact_selected_set",
        "options": [
          { "optionId": "idempotency", "text": "Use an idempotency key" },
          { "optionId": "bounded-retry", "text": "Use a bounded retry policy" },
          { "optionId": "silent-loop", "text": "Retry forever without state" },
          { "optionId": "repair-state", "text": "Expose a repair state" }
        ]
      },
      "answer": {
        "type": "choice_multiple",
        "optionIds": ["idempotency", "bounded-retry", "repair-state"]
      },
      "feedback": {
        "type": "choice_multiple",
        "reason": "Safe retries need identity, a bounded policy, and a visible repair path.",
        "details": {},
        "messages": [
          { "kind": "wrong_option", "targetId": "silent-loop", "text": "An unbounded silent loop hides failure and can duplicate work." },
          { "kind": "omitted_option", "targetId": "idempotency", "text": "Without identity, a retry can duplicate the operation." },
          { "kind": "omitted_option", "targetId": "bounded-retry", "text": "A retry needs an explicit limit and classification." },
          { "kind": "omitted_option", "targetId": "repair-state", "text": "Users need a visible path when recovery is unavailable." }
        ]
      },
      "difficulty": "intermediate",
      "sourceRefs": ["fixture://simp-01/choice-multiple"]
    },
    {
      "questionId": "simp01-ordering",
      "trackId": "coding-interview-dsa-problem-solving",
      "nodeId": "simp01-interactions",
      "mentalUnitId": "simp01-ordering-unit",
      "prompt": "Put the recovery steps in the order that preserves the user's intent.",
      "constraints": ["Every element must appear exactly once.", "The sequence must expose failure before claiming success."],
      "interaction": {
        "type": "ordering",
        "scoringMethod": "adjacent_relations",
        "elements": [
          { "elementId": "observe", "text": "Observe the current evidence" },
          { "elementId": "preserve", "text": "Preserve repairable intent" },
          { "elementId": "expose", "text": "Expose the unavailable state" },
          { "elementId": "recover", "text": "Recover and confirm the result" }
        ]
      },
      "answer": {
        "type": "ordering",
        "orderedElementIds": ["observe", "preserve", "expose", "recover"]
      },
      "feedback": {
        "type": "ordering",
        "reason": "Evidence and intent are preserved before the repair outcome is confirmed.",
        "details": {},
        "messages": [
          { "kind": "wrong_element", "targetId": "observe", "text": "Start by observing the boundary that failed." },
          { "kind": "wrong_element", "targetId": "preserve", "text": "Preserve repairable intent before changing state." },
          { "kind": "wrong_element", "targetId": "expose", "text": "Expose unavailable or partial state instead of masking it." },
          { "kind": "wrong_element", "targetId": "recover", "text": "Confirm the resulting state after recovery." },
          { "kind": "broken_relation", "targetId": "observe->preserve", "text": "Observation must precede preservation of intent." },
          { "kind": "broken_relation", "targetId": "preserve->expose", "text": "The user intent must be safe before the unavailable state is exposed." },
          { "kind": "broken_relation", "targetId": "expose->recover", "text": "Recovery should follow an explicit unavailable state." }
        ]
      },
      "difficulty": "intermediate",
      "sourceRefs": ["fixture://simp-01/ordering"]
    },
    {
      "questionId": "simp01-complexity",
      "trackId": "coding-interview-dsa-problem-solving",
      "nodeId": "simp01-interactions",
      "mentalUnitId": "simp01-complexity-unit",
      "prompt": "Select the tightest complexity for a single linear scan using constant working state.",
      "constraints": ["The input is scanned once.", "No collection grows with the input."],
      "interaction": {
        "type": "complexity",
        "scoringMethod": "dimension_exact",
        "dimensions": [
          {
            "dimensionId": "time",
            "label": "Time complexity",
            "values": [
              { "valueId": "constant", "text": "O(1)" },
              { "valueId": "linear", "text": "O(n)" },
              { "valueId": "quadratic", "text": "O(n^2)" }
            ],
            "acceptedValueIds": ["linear"],
            "aliases": { "n-linear": "linear" }
          },
          {
            "dimensionId": "auxiliary-space",
            "label": "Auxiliary space",
            "values": [
              { "valueId": "constant", "text": "O(1)" },
              { "valueId": "linear", "text": "O(n)" },
              { "valueId": "quadratic", "text": "O(n^2)" }
            ],
            "acceptedValueIds": ["constant"]
          }
        ]
      },
      "answer": {
        "type": "complexity",
        "selectedValueIdsByDimension": {
          "time": ["linear"],
          "auxiliary-space": ["constant"]
        }
      },
      "feedback": {
        "type": "complexity",
        "reason": "One scan is linear and constant working state is constant auxiliary space.",
        "details": {},
        "messages": [
          { "kind": "wrong_value", "targetId": "time|constant", "text": "The scan must inspect the input, so constant time is too small." },
          { "kind": "wrong_value", "targetId": "time|quadratic", "text": "A single scan does not perform quadratic work." },
          { "kind": "wrong_value", "targetId": "auxiliary-space|linear", "text": "The algorithm retains only constant working state." },
          { "kind": "wrong_value", "targetId": "auxiliary-space|quadratic", "text": "No input-sized structure is retained." },
          { "kind": "omitted_dimension", "targetId": "time", "text": "A time choice is required to score the dimension." },
          { "kind": "omitted_dimension", "targetId": "auxiliary-space", "text": "An auxiliary-space choice is required to score the dimension." }
        ]
      },
      "difficulty": "foundational",
      "sourceRefs": ["fixture://simp-01/complexity"]
    },
    {
      "questionId": "simp01-decision-matrix",
      "trackId": "coding-interview-dsa-problem-solving",
      "nodeId": "simp01-interactions",
      "mentalUnitId": "simp01-decision-matrix-unit",
      "prompt": "Choose the design decision for each independent boundary.",
      "constraints": ["Choose one value for every dimension.", "Keep authority and failure behavior explicit."],
      "interaction": {
        "type": "decision_matrix",
        "scoringMethod": "dimension_exact",
        "dimensions": [
          {
            "dimensionId": "authority",
            "label": "Authority",
            "values": [
              { "valueId": "trusted-service", "text": "Enforce the result at the trusted service" },
              { "valueId": "hidden-control", "text": "Hide the control in the client" },
              { "valueId": "client-check", "text": "Trust a client-only check" }
            ],
            "acceptedValueIds": ["trusted-service"]
          },
          {
            "dimensionId": "failure",
            "label": "Failure behavior",
            "values": [
              { "valueId": "deny-and-repair", "text": "Deny safely and expose repair" },
              { "valueId": "silent-retry", "text": "Retry silently" },
              { "valueId": "fail-open", "text": "Allow the action when policy is unknown" }
            ],
            "acceptedValueIds": ["deny-and-repair"]
          }
        ]
      },
      "answer": {
        "type": "decision_matrix",
        "selectedValueIdsByDimension": {
          "authority": ["trusted-service"],
          "failure": ["deny-and-repair"]
        }
      },
      "feedback": {
        "type": "decision_matrix",
        "reason": "The trusted boundary owns enforcement and exposes a repairable failure.",
        "details": {},
        "messages": [
          { "kind": "wrong_value", "targetId": "authority|hidden-control", "text": "Hiding a control is not authorization." },
          { "kind": "wrong_value", "targetId": "authority|client-check", "text": "A client check is not a trusted enforcement boundary." },
          { "kind": "wrong_value", "targetId": "failure|silent-retry", "text": "Silent retries conceal the failure and have no repair budget." },
          { "kind": "wrong_value", "targetId": "failure|fail-open", "text": "Unknown policy must not allow the protected action." },
          { "kind": "omitted_dimension", "targetId": "authority", "text": "The enforcement owner must be explicit." },
          { "kind": "omitted_dimension", "targetId": "failure", "text": "The unavailable or denied state must have a repair behavior." }
        ]
      },
      "difficulty": "advanced",
      "sourceRefs": ["fixture://simp-01/decision-matrix"]
    }
  ]
}
