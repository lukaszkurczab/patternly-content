{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateId",
    "status",
    "release",
    "review",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "patternly-content-candidate-draft-v2"
    },
    "candidateId": {
      "type": "string",
      "minLength": 64
    },
    "status": {
      "const": "draft_not_admitted"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "releasePath",
        "checksumSha256",
        "sourceRepositoryCommit"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1
        },
        "releasePath": {
          "const": "release/release.json"
        },
        "checksumSha256": {
          "type": "string",
          "minLength": 64
        },
        "sourceRepositoryCommit": {
          "type": "string",
          "minLength": 40
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateApproval",
        "publishingAdmission",
        "runtimeAdmission",
        "appReleaseLockUpdated"
      ],
      "properties": {
        "candidateApproval": {
          "const": "not_granted"
        },
        "publishingAdmission": {
          "const": "not_granted"
        },
        "runtimeAdmission": {
          "const": "not_granted"
        },
        "appReleaseLockUpdated": {
          "const": false
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "aws-certified-solutions-architect-associate"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "backend-system-design-interview"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "claude-certified-architect-professional-certification"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "coding-interview-dsa-problem-solving"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "frontend-system-design-interview"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "google-cloud-associate-cloud-engineer"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "microsoft-azure-administrator-associate-az-104"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "microsoft-azure-ai-fundamentals-ai-901"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trackId"
            ],
            "properties": {
              "trackId": {
                "const": "object-oriented-design-interview"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1,
          "type": "array"
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trackId",
          "familyId",
          "sourcePath",
          "contentVersion",
          "questionCount",
          "questionSetSha256",
          "artifactPath",
          "artifactBytes",
          "checksumSha256"
        ],
        "properties": {
          "trackId": {
            "type": "string",
            "enum": [
              "aws-certified-solutions-architect-associate",
              "backend-system-design-interview",
              "claude-certified-architect-professional-certification",
              "coding-interview-dsa-problem-solving",
              "frontend-system-design-interview",
              "google-cloud-associate-cloud-engineer",
              "microsoft-azure-administrator-associate-az-104",
              "microsoft-azure-ai-fundamentals-ai-901",
              "object-oriented-design-interview"
            ]
          },
          "familyId": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "contentVersion": {
            "type": "string",
            "minLength": 1
          },
          "questionCount": {
            "type": "integer"
          },
          "questionSetSha256": {
            "type": "string",
            "minLength": 64
          },
          "artifactPath": {
            "type": "string",
            "minLength": 1
          },
          "artifactBytes": {
            "type": "integer"
          },
          "checksumSha256": {
            "type": "string",
            "minLength": 64
          },
          "canonicalApprovalBinding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "addendumId",
              "approvalPath",
              "scope",
              "trackSha256",
              "nodeId",
              "nodeSha256",
              "newQuestionIds"
            ],
            "properties": {
              "addendumId": {
                "const": "odk-096-aws-free-node-v1"
              },
              "approvalPath": {
                "const": "evidence/canonical-content-approvals/odk-096-aws-free-node-v1.json"
              },
              "scope": {
                "const": "aws_local_canonical_producer_only"
              },
              "trackSha256": {
                "type": "string",
                "minLength": 64
              },
              "nodeId": {
                "const": "aws_secure_architecture_foundations"
              },
              "nodeSha256": {
                "type": "string",
                "minLength": 64
              },
              "newQuestionIds": {
                "type": "array",
                "minItems": 36,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
