{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundled-free-node-v2",
  "title": "Patternly deterministic compressed bundled Free-node package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifest", "payloadGzipBase64"],
  "properties": {
    "schemaVersion": { "const": "bundled-free-node-v2" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleKind", "packageVersion", "trackId", "familyId", "freeNodeId", "contentVersion", "taxonomyVersion", "itemCount", "modeIds", "assetCount", "profileId", "profileVersion", "minimumAppVersion", "payloadSchemaVersion", "payloadCompression", "payloadUncompressedSize", "payloadCompressedSize", "payloadCanonicalSha256", "payloadCompressedSha256", "provenance"],
      "properties": {
        "bundleKind": { "const": "bundled_free_node" },
        "packageVersion": { "type": "string", "minLength": 1 },
        "trackId": { "type": "string", "minLength": 1 },
        "familyId": { "enum": ["certification", "coding_interview", "design_interview"] },
        "freeNodeId": { "type": "string", "minLength": 1 },
        "contentVersion": { "type": "string", "minLength": 1 },
        "taxonomyVersion": { "type": "string", "minLength": 1 },
        "itemCount": { "type": "integer" },
        "modeIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "assetCount": { "type": "integer" },
        "profileId": { "type": "string", "minLength": 1 },
        "profileVersion": { "type": "string", "minLength": 1 },
        "minimumAppVersion": { "type": "string", "minLength": 1 },
        "payloadSchemaVersion": { "const": "bundled-free-node-payload-v2" },
        "payloadCompression": { "const": "gzip-level-9-mtime-0-v1" },
        "payloadUncompressedSize": { "type": "integer" },
        "payloadCompressedSize": { "type": "integer" },
        "payloadCanonicalSha256": { "type": "string", "minLength": 64 },
        "payloadCompressedSha256": { "type": "string", "minLength": 64 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["releaseId", "sourceRepositoryCommit", "sourceArtifactSchemaVersion", "sourceArtifactChecksumSha256", "technicalEvidencePath", "technicalEvidenceFileSha256", "technicalEvidenceIdentitySha256", "technicalEvidenceSourceCommit", "technicalEvidenceInputManifestSha256", "technicalInputFingerprint", "inventorySchemaVersion", "inventoryCanonicalSha256", "trackBriefSchemaVersion", "trackBriefCanonicalSha256", "freeNodeExperienceProfileSchemaVersion", "freeNodeExperienceProfileCanonicalSha256", "profileSourceRepositoryCommit", "trackConfigCanonicalSha256", "builderVersion"],
          "properties": {
            "releaseId": { "type": "string", "minLength": 1 },
            "sourceRepositoryCommit": { "type": "string", "minLength": 40 },
            "sourceArtifactSchemaVersion": { "const": "published-bank-v1" },
            "sourceArtifactChecksumSha256": { "type": "string", "minLength": 64 },
            "technicalEvidencePath": { "type": "string", "minLength": 1 },
            "technicalEvidenceFileSha256": { "type": "string", "minLength": 64 },
            "technicalEvidenceIdentitySha256": { "type": "string", "minLength": 64 },
            "technicalEvidenceSourceCommit": { "type": "string", "minLength": 40 },
            "technicalEvidenceInputManifestSha256": { "type": "string", "minLength": 64 },
            "technicalInputFingerprint": { "type": "string", "minLength": 64 },
            "inventorySchemaVersion": { "const": "patternly-free-node-inventory-v1" },
            "inventoryCanonicalSha256": { "type": "string", "minLength": 64 },
            "trackBriefSchemaVersion": { "const": "patternly-track-brief-v2" },
            "trackBriefCanonicalSha256": { "type": "string", "minLength": 64 },
            "freeNodeExperienceProfileSchemaVersion": { "const": "patternly-free-node-experience-profile-v1" },
            "freeNodeExperienceProfileCanonicalSha256": { "type": "string", "minLength": 64 },
            "profileSourceRepositoryCommit": { "type": "string", "minLength": 40 },
            "trackConfigCanonicalSha256": { "type": "string", "minLength": 64 },
            "builderVersion": { "const": "bundled-free-node-builder-v2" }
          }
        }
      }
    },
    "payloadGzipBase64": { "type": "string", "minLength": 1 }
  }
}
