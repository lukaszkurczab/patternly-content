{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-free-node-inventory-pins-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pins"],
  "properties": {
    "schemaVersion": { "const": "patternly-free-node-inventory-pins-v1" },
    "pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trackId", "releaseId", "contentVersion", "sourceRepositoryCommit", "artifactChecksumSha256", "technicalEvidencePath", "technicalEvidenceFileSha256", "technicalEvidenceIdentitySha256", "technicalInputFingerprint"],
        "properties": {
          "trackId": { "type": "string", "minLength": 1 },
          "releaseId": { "type": "string", "minLength": 1 },
          "contentVersion": { "type": "string", "minLength": 1 },
          "sourceRepositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "artifactChecksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "technicalEvidencePath": { "type": "string", "minLength": 1 },
          "technicalEvidenceFileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "technicalEvidenceIdentitySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "technicalInputFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
