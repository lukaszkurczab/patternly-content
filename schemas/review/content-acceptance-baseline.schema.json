{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-content-acceptance-baseline-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baselineId",
    "provenance",
    "canonicalRepresentation",
    "tracks"
  ],
  "properties": {
    "schemaVersion": { "const": "patternly-content-acceptance-baseline-v1" },
    "baselineId": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "confirmationDate", "confirmationSource"],
      "properties": {
        "kind": { "const": "human_owner" },
        "id": { "type": "string", "minLength": 1 },
        "confirmationDate": { "type": "string", "minLength": 1 },
        "confirmationSource": { "const": "owner_confirmation_in_active_conversation" }
      }
    },
    "canonicalRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalJsonVersion", "trackOrder", "sourceManifest", "itemManifest"],
      "properties": {
        "canonicalJsonVersion": { "const": "canonical-json-v1" },
        "trackOrder": { "const": "ascending-track-id" },
        "sourceManifest": { "const": "sha256(canonicalJson(sorted [{path,sha256}]))" },
        "itemManifest": { "const": "sha256(canonicalJson(sorted [{id,fingerprint}]))" }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trackId",
          "sourceCommit",
          "sourceRoot",
          "sourceFileCount",
          "canonicalItemCount",
          "sourceManifestSha256",
          "itemManifestSha256"
        ],
        "properties": {
          "trackId": { "type": "string", "minLength": 1 },
          "sourceCommit": { "type": "string", "minLength": 40 },
          "sourceRoot": { "type": "string", "minLength": 1 },
          "contentVersion": { "type": "string", "minLength": 1 },
          "sourceFileCount": { "type": "integer" },
          "canonicalItemCount": { "type": "integer" },
          "sourceManifestSha256": { "type": "string", "minLength": 64 },
          "itemManifestSha256": { "type": "string", "minLength": 64 }
        }
      }
    }
  }
}
