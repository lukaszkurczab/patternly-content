{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternly.dev/schemas/content/approach-challenge-problem-v1.json",
  "title": "Patternly paired Coding Interview approach challenge v1",
  "description": "One complete, stable, two-stage problem. Stored outside content/<trackId> so it cannot enter legacy canonical question pools.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "approach-challenge-problem-v1" },
    "problemId": { "$ref": "https://patternly.dev/schemas/content/question-v1.json#/$defs/id" },
    "problemVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "trackId": { "const": "coding-interview-dsa-problem-solving" },
    "primaryFamilyId": { "$ref": "https://patternly.dev/schemas/content/question-v1.json#/$defs/id" },
    "requiredFamilyIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "https://patternly.dev/schemas/content/question-v1.json#/$defs/id" } },
    "difficulty": { "enum": ["easy", "medium", "hard"] },
    "approachQuestion": { "$ref": "https://patternly.dev/schemas/content/question-v1.json#/$defs/approachChoiceQuestion" },
    "complexityQuestion": { "$ref": "https://patternly.dev/schemas/content/question-v1.json#/$defs/choiceSingleQuestion" },
    "analyzedApproachId": { "$ref": "https://patternly.dev/schemas/content/question-v1.json#/$defs/id" },
    "methodReveal": {
      "type": "object",
      "properties": {
        "title": { "$ref": "https://patternly.dev/schemas/content/question-v1.json#/$defs/learnerText" },
        "description": { "$ref": "https://patternly.dev/schemas/content/question-v1.json#/$defs/learnerText", "not": { "pattern": "\\bO\\s*\\(" } }
      },
      "required": ["title", "description"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "problemId", "problemVersion", "trackId", "primaryFamilyId", "requiredFamilyIds", "difficulty", "approachQuestion", "complexityQuestion", "analyzedApproachId", "methodReveal"],
  "additionalProperties": false
}
