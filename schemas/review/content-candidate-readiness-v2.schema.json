{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidatePath", "candidateId", "sourceRepositoryCommit", "release", "trackIds", "candidateApproval", "publishingAdmission", "runtimeAdmission", "appReleaseLockUpdated", "tracks"],
  "properties": {
    "schemaVersion": { "const": "patternly-content-candidate-readiness-v2" },
    "candidatePath": { "const": "reports/candidate-reconciliation/AWS-02-DRAFT/candidate/manifest.json" },
    "candidateId": { "type": "string", "minLength": 64 },
    "sourceRepositoryCommit": { "type": "string", "minLength": 40 },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseId", "releasePath", "checksumSha256"],
      "properties": {
        "releaseId": { "type": "string", "minLength": 1 },
        "releasePath": { "const": "reports/candidate-reconciliation/AWS-02-DRAFT/release/release.json" },
        "checksumSha256": { "type": "string", "minLength": 64 }
      }
    },
    "trackIds": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "string" } },
    "candidateApproval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "decisionId", "decisionPath", "decisionSha256"],
      "properties": {
        "status": { "const": "approved" },
        "decisionId": { "type": "string", "minLength": 1 },
        "decisionPath": { "const": "evidence/candidate-decisions/aws-02-codex-decision-v2.json" },
        "decisionSha256": { "type": "string", "minLength": 64 }
      }
    },
    "publishingAdmission": { "const": "not_granted" },
    "runtimeAdmission": { "const": "not_granted" },
    "appReleaseLockUpdated": { "const": false },
    "tracks": { "type": "array", "minItems": 9, "maxItems": 9, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["trackId", "sourcePath", "artifactPath", "questionCount", "questionSetSha256", "artifactSha256", "publishingAdmission", "runtimeAdmission"],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "artifactPath": { "type": "string", "minLength": 1 },
        "questionCount": { "type": "integer" },
        "questionSetSha256": { "type": "string", "minLength": 64 },
        "artifactSha256": { "type": "string", "minLength": 64 },
        "publishingAdmission": { "const": "not_granted" },
        "runtimeAdmission": { "const": "not_granted" }
      }
    } }
  }
}
