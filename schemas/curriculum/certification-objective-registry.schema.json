{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification objective registry",
  "type": "object",
  "required": ["schemaVersion", "trackId", "provider", "certification", "examVariant", "guideVersion", "checkedDate", "officialSourceHosts", "firstPartyDocumentationHosts", "sources", "domains", "objectives", "examProfile"],
  "properties": {
    "schemaVersion": { "const": "patternly-certification-objective-registry-v1" },
    "trackId": { "type": "string", "minLength": 1 },
    "guideVersion": { "type": "string", "minLength": 1 },
    "checkedDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "officialSourceHosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "firstPartyDocumentationHosts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "properties": { "urlIdentity": { "type": "object", "properties": { "kind": { "type": "string" }, "owner": { "type": "string" }, "repository": { "type": "string" }, "ref": { "type": "string" }, "path": { "type": "string" } }, "required": ["kind", "owner", "repository", "ref", "path"] }, "contentDigest": { "type": "object", "properties": { "algorithm": { "const": "sha256" }, "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "required": ["algorithm", "value"] } } } },
    "domains": { "type": "array", "minItems": 1 },
    "objectives": { "type": "array", "minItems": 1 },
    "examProfile": { "type": "object" }
  }
}
