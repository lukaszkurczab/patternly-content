{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-free-node-experience-profile-v1",
  "title": "Patternly track-owned closed Free-node experience profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "profileVersion", "trackId", "familyId", "freeNodeId", "primaryEntry", "modes"],
  "properties": {
    "schemaVersion": { "const": "patternly-free-node-experience-profile-v1" },
    "profileId": { "type": "string", "minLength": 1 },
    "profileVersion": { "type": "string", "minLength": 1 },
    "trackId": { "type": "string", "minLength": 1 },
    "familyId": { "enum": ["coding_interview", "certification", "design_interview"] },
    "freeNodeId": { "type": "string", "minLength": 1 },
    "primaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modeId", "requestedLength"],
      "properties": {
        "modeId": { "type": "string", "minLength": 1 },
        "requestedLength": { "type": "integer" }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["configurationId", "configurationVersion", "modeId", "blueprintModeId", "availability", "requestedLengths", "defaultRequestedLength", "selection", "reinsertPolicy"],
        "properties": {
          "configurationId": { "type": "string", "minLength": 1 },
          "configurationVersion": { "type": "string", "minLength": 1 },
          "modeId": { "type": "string", "minLength": 1 },
          "blueprintModeId": { "type": "string", "minLength": 1 },
          "availability": { "enum": ["immediate", "evidence_conditioned"] },
          "requestedLengths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer" } },
          "defaultRequestedLength": { "type": "integer" },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "freeNodeId", "itemSource", "requireUniqueItemIds"],
            "properties": {
              "kind": { "enum": ["exact_free_node", "learner_selected_free_node_mental_unit", "free_node_review_evidence", "due_free_node_review_evidence"] },
              "freeNodeId": { "type": "string", "minLength": 1 },
              "itemSource": { "const": "package_items" },
              "requireUniqueItemIds": { "const": true },
              "itemIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "reviewSources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["due_queue", "session_misses"] } },
              "sessionMissesMustBeCommitted": { "type": "boolean" },
              "emptyEligibility": { "const": "unavailable" },
              "shortening": { "const": "truthful_to_eligible_count" }
            }
          },
          "feedbackOptions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["afterEachAnswer", "atSessionEnd"] } },
          "reinsertPolicy": { "enum": ["disabled", "canonical_family_package_local"] }
        }
      }
    }
  }
}
