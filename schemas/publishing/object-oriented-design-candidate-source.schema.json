{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "object-oriented-design-interview-candidate-source-v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "candidateStatus", "activationState", "trackId", "familyId", "runtimeAdmission", "publishingAdmission", "contentVersion", "taxonomyVersion", "nodeId", "mentalUnitIds", "items", "authoringProvenance"],
  "properties": {
    "schemaVersion": { "const": "object-oriented-design-interview-candidate-source-v1" },
    "candidateStatus": { "const": "generated_and_mechanically_validated_pending_human_review" },
    "activationState": { "const": "inactive_candidate" },
    "trackId": { "const": "object-oriented-design-interview" },
    "familyId": { "const": "object_oriented_design" },
    "runtimeAdmission": { "const": "not_admitted" },
    "publishingAdmission": { "const": "not_admitted" },
    "items": { "type": "array", "minItems": 1 },
    "authoringProvenance": { "type": "object", "required": ["authoringMethod", "approvalStatus", "author", "createdAt", "contentBatchId"] }
  }
}
