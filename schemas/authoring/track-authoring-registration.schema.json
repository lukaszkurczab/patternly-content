{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-track-authoring-registration-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trackId",
    "familyId",
    "curriculumPath",
    "trackBriefPath",
    "manualSourceRoot",
    "familySourceSchemaPath",
    "taxonomyPaths",
    "sourceRegistryPaths",
    "examOrModeProfilePath",
    "layoutPolicyId"
  ],
  "properties": {
    "schemaVersion": { "const": "patternly-track-authoring-registration-v1" },
    "trackId": { "type": "string", "minLength": 1 },
    "familyId": { "type": "string", "enum": ["coding_interview", "certification", "design_interview"] },
    "curriculumPath": { "type": "string", "minLength": 1 },
    "trackBriefPath": { "type": "string", "minLength": 1 },
    "manualSourceRoot": { "type": "string", "minLength": 1 },
    "familySourceSchemaPath": { "type": "string", "minLength": 1 },
    "taxonomyPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sourceRegistryPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "examOrModeProfilePath": { "type": "string", "minLength": 1 },
    "layoutPolicyId": { "type": "string", "minLength": 1 },
    "sourceLayout": { "enum": ["learning-block", "node"] },
    "authoringVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentVersion", "taxonomyVersionSource"],
      "properties": {
        "contentVersion": { "type": "string", "minLength": 1 },
        "taxonomyVersionSource": { "const": "curriculumVersion" }
      }
    }
  }
}
