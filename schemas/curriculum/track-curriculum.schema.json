{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-track-curriculum-v1",
  "type": "object",
  "required": ["schemaVersion", "curriculumVersion", "trackId", "familyId", "trackBriefReference", "freeNodeId", "entryPrerequisites", "learnerOutcome", "sourceBasis", "nodes", "crossNodeRelationships", "modePoolPlans", "simulationOrCasePoolPlans", "contentOwnershipRules", "crossTrackOverlapRules", "targetItemCount"],
  "properties": {
    "schemaVersion": { "const": "patternly-track-curriculum-v1" },
    "curriculumVersion": { "type": "string", "minLength": 1 },
    "trackId": { "type": "string", "minLength": 1 },
    "familyId": { "enum": ["coding_interview", "certification", "design_interview"] },
    "nodes": { "type": "array", "minItems": 1 },
    "sourceBasis": { "type": "array", "minItems": 1 },
    "targetItemCount": { "type": "integer", "minimum": 1 }
  }
}
