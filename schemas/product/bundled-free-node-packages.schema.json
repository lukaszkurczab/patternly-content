{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-bundled-free-node-packages-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packages"],
  "properties": {
    "schemaVersion": { "const": "patternly-bundled-free-node-packages-v1" },
    "packages": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trackId", "packageVersion", "minimumAppVersion"],
        "properties": {
          "trackId": { "type": "string", "minLength": 1 },
          "packageVersion": { "type": "string", "minLength": 1 },
          "minimumAppVersion": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
