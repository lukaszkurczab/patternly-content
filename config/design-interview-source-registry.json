  "claims": [
    {
      "claimId": "ui-component-name-role-value-and-change-notification",
      "statement": "For user interface components, name and role are programmatically determinable; user-settable states, properties, and values are programmatically settable; change notification is available to user agents including assistive technologies.",
      "scope": "WCAG 2.2 Success Criterion 4.1.2",
      "exclusions": [
        "does not prescribe one universal widget implementation"
      ]
    },
    {
      "claimId": "visible-label-text-contained-in-accessible-name",
      "statement": "When a control has a visible text label, its accessible name contains that text subject to the Success Criterion exceptions.",
      "scope": "WCAG 2.2 Success Criterion 2.5.3",
      "exclusions": [
        "does not require every accessible name to be visible"
      ]
    },
    {
      "claimId": "sequential-focus-preserves-meaning-and-operability",
      "statement": "When sequential navigation order affects meaning or operation, focusable components receive focus in an order that preserves meaning and operability.",
      "scope": "WCAG 2.2 Success Criterion 2.4.3",
      "exclusions": [
        "does not prescribe DOM order as the only implementation"
      ]
    },
    {
      "claimId": "text-contrast-thresholds-and-exceptions",
      "statement": "Text and images of text meet the WCAG 2.2 minimum contrast ratios subject to the stated large-text, incidental, and logotype exceptions.",
      "scope": "WCAG 2.2 Success Criterion 1.4.3",
      "exclusions": [
        "does not apply the normal-text ratio to exempt content"
      ]
    },
    {
      "claimId": "non-text-ui-state-contrast-thresholds-and-exceptions",
      "statement": "Visual information needed to identify user interface components and states meets the WCAG 2.2 non-text contrast criterion subject to its exceptions.",
      "scope": "WCAG 2.2 Success Criterion 1.4.11",
      "exclusions": [
        "does not treat inactive components as in-scope when the criterion excludes them"
      ]
    },
    {
      "claimId": "text-resize-without-loss",
      "statement": "Except for captions and images of text, text can be resized up to 200 percent without loss of content or functionality.",
      "scope": "WCAG 2.2 Success Criterion 1.4.4",
      "exclusions": [
        "does not claim that browser zoom and text-only resize are identical mechanisms"
      ]
    },
    {
      "claimId": "reflow-without-loss-or-two-dimensional-scrolling",
      "statement": "Ordinary content can be presented without loss of information or functionality and without two-dimensional scrolling at the criterion's stated dimensions, except for content requiring two-dimensional layout for usage or meaning.",
      "scope": "WCAG 2.2 Success Criterion 1.4.10",
      "exclusions": [
        "preserves the two-dimensional-layout exception"
      ]
    },
    {
      "claimId": "aria-role-must-match-defined-role-semantics",
      "statement": "A custom control exposes an applicable non-abstract WAI-ARIA role with the semantics and required properties defined for that role.",
      "scope": "WAI-ARIA 1.2 role model and role definitions",
      "exclusions": [
        "does not use abstract roles",
        "does not override conflicting strong native semantics"
      ]
    },
    {
      "claimId": "aria-current-state-and-value-properties",
      "statement": "Applicable WAI-ARIA states and properties expose the current control state or value according to their defined semantics and allowed values.",
      "scope": "WAI-ARIA 1.2 states and properties",
      "exclusions": [
        "does not invent a property unsupported by the chosen role"
      ]
    },
    {
      "claimId": "accessible-name-source-precedence-and-computation",
      "statement": "Accessible names are computed from referenced author labels, aria-label, host-language labeling, or name-from-content according to the normative precedence algorithm.",
      "scope": "Accessible Name and Description Computation 1.1 section 4.3",
      "exclusions": [
        "does not treat placeholder or visual position as a stable label without a conforming name source"
      ]
    }
  ],
