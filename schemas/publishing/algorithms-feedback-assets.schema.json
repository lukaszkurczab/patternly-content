{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "algorithms-feedback-assets-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trackId", "assets"],
  "properties": {
    "schemaVersion": { "const": "algorithms-feedback-assets-v1" },
    "trackId": { "const": "algorithms" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourcePath", "sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourcePath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "minLength": 64 }
        }
      }
    }
  }
}
