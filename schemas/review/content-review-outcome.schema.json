{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-content-review-outcome-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviews"
  ],
  "properties": {
    "schemaVersion": { "const": "patternly-content-review-outcome-v1" },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trackId", "itemId", "nodeId", "learningBlockId", "sourceFile", "sourceFileSha256", "itemFingerprint", "itemSnapshot", "outcome", "note", "reviewerId", "reviewedAt"],
        "properties": {
          "trackId": { "type": "string", "minLength": 1 },
          "itemId": { "type": "string", "minLength": 1 },
          "nodeId": { "type": "string", "minLength": 1 },
          "learningBlockId": { "type": "string", "minLength": 1 },
          "sourceFile": { "type": "string", "minLength": 1 },
          "sourceFileSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "itemFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "itemSnapshot": { "type": "object" },
          "outcome": { "enum": ["approved", "needs_change", "rejected"] },
          "note": { "type": "string", "minLength": 1 },
          "reviewerId": { "type": "string", "minLength": 1 },
          "reviewedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
