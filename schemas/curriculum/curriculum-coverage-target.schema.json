{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-curriculum-coverage-target-v1",
  "type": "object",
  "required": ["coverageTargetId", "blockId", "primarySkillOrDecisionAtomId", "directSkillOrDecisionAtomIds", "diagnosticDecision", "learningObjective", "decisiveBoundary", "misconceptionOrCompetingDecision", "transferBoundary", "learningOperation", "preferredInteractionContract", "interactionContractStatus", "difficultyIntent", "modeRoles", "scenarioOrSurfaceVariationAxes", "requiredVariantCount", "variantCountRationale", "sourceRequirements", "overlapExclusions"],
  "properties": {
    "primarySkillOrDecisionAtomId": { "type": "string", "minLength": 1 },
    "learningOperation": { "enum": ["recognition", "selection", "boundary", "decision_diagnosis"] },
    "directSkillOrDecisionAtomIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scenarioOrSurfaceVariationAxes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredVariantCount": { "type": "integer", "minimum": 1 },
    "operationVariantCounts": {
      "type": "object",
      "propertyNames": { "enum": ["SIG", "DEC", "BND", "XFR", "S", "D", "F", "T", "I"] },
      "additionalProperties": { "$ref": "#/$defs/operationCount" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "learningOperation": { "const": "decision_diagnosis" } }, "required": ["learningOperation"] },
      "then": { "properties": { "directSkillOrDecisionAtomIds": { "maxItems": 1 } } }
    }
  ],
  "$defs": {
    "operationCount": {
      "type": "object",
      "required": ["requiredVariantCount", "countRationale"],
      "properties": {
        "requiredVariantCount": { "type": "integer", "minimum": 1 },
        "countRationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
