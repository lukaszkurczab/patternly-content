{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-free-node-inventory-v1",
  "title": "Patternly immutable free-node inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "trackId", "familyId", "freeNodeId", "selector", "producer", "itemCount", "items"],
  "properties": {
    "schemaVersion": { "const": "patternly-free-node-inventory-v1" },
    "trackId": { "type": "string", "minLength": 1 },
    "familyId": { "type": "string", "minLength": 1 },
    "freeNodeId": { "type": "string", "minLength": 1 },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "equals"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "equals": { "type": "string", "minLength": 1 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseId", "contentVersion", "sourceRepositoryCommit", "artifactChecksumSha256"],
      "properties": {
        "releaseId": { "type": "string", "minLength": 1 },
        "contentVersion": { "type": "string", "minLength": 1 },
        "sourceRepositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "artifactChecksumSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "itemCount": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "itemFingerprint"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "itemFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
