{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patternly.dev/schemas/content/question-v1.json",
  "title": "Patternly canonical question v1",
  "description": "Family-neutral question contract. The five oneOf branches are disjoint by interaction.type.",
  "type": "object",
  "properties": {
    "questionId": { "$ref": "#/$defs/id" },
    "trackId": { "$ref": "#/$defs/id" },
    "nodeId": { "$ref": "#/$defs/id" },
    "mentalUnitId": { "$ref": "#/$defs/id" },
    "prompt": { "$ref": "#/$defs/learnerText" },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/learnerText" } },
    "interaction": { "type": "object" },
    "answer": { "type": "object" },
    "feedback": { "type": "object" },
    "difficulty": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }
  },
  "required": ["questionId", "trackId", "nodeId", "mentalUnitId", "prompt", "interaction", "answer", "feedback", "difficulty"],
  "additionalProperties": false,
  "oneOf": [
    { "$ref": "#/$defs/choiceSingleQuestion" },
    { "$ref": "#/$defs/choiceMultipleQuestion" },
    { "$ref": "#/$defs/orderingQuestion" },
    { "$ref": "#/$defs/complexityQuestion" },
    { "$ref": "#/$defs/decisionMatrixQuestion" }
  ],
  "$defs": {
    "learnerText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF]*[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF][\\s\\S]*(?![\\s\\S])"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF](?:[\\s\\S]*[^\\u0009-\\u000D\\u001C-\\u001F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF])?(?![\\s\\S])"
    },
    "jsonValue": {
      "anyOf": [
        { "$ref": "#/$defs/learnerText" },
        { "type": ["number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "option": {
      "type": "object",
      "properties": {
        "optionId": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/learnerText" },
        "explanation": { "$ref": "#/$defs/learnerText" }
      },
      "required": ["optionId", "text"],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "elementId": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/learnerText" }
      },
      "required": ["elementId", "text"],
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "properties": {
        "valueId": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/learnerText" }
      },
      "required": ["valueId", "text"],
      "additionalProperties": false
    },
    "aliases": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/id" }
    },
    "dimension": {
      "type": "object",
      "properties": {
        "dimensionId": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/learnerText" },
        "values": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/value" } },
        "acceptedValueIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      },
      "required": ["dimensionId", "label", "values", "acceptedValueIds"],
      "additionalProperties": false
    },
    "complexityDimension": {
      "type": "object",
      "properties": {
        "dimensionId": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/learnerText" },
        "values": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/value" } },
        "acceptedValueIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "aliases": { "$ref": "#/$defs/aliases" }
      },
      "required": ["dimensionId", "label", "values", "acceptedValueIds"],
      "additionalProperties": false
    },
    "choiceSingleInteraction": {
      "type": "object",
      "properties": { "type": { "const": "choice_single" }, "scoringMethod": { "const": "exact_selected_set" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } } },
      "required": ["type", "scoringMethod", "options"],
      "additionalProperties": false
    },
    "choiceMultipleInteraction": {
      "type": "object",
      "properties": { "type": { "const": "choice_multiple" }, "scoringMethod": { "const": "exact_selected_set" }, "options": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/option" } } },
      "required": ["type", "scoringMethod", "options"],
      "additionalProperties": false
    },
    "orderingInteraction": {
      "type": "object",
      "properties": { "type": { "const": "ordering" }, "scoringMethod": { "const": "adjacent_relations" }, "elements": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/element" } } },
      "required": ["type", "scoringMethod", "elements"],
      "additionalProperties": false
    },
    "complexityInteraction": {
      "type": "object",
      "properties": { "type": { "const": "complexity" }, "scoringMethod": { "const": "dimension_exact" }, "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/complexityDimension" } } },
      "required": ["type", "scoringMethod", "dimensions"],
      "additionalProperties": false
    },
    "decisionMatrixInteraction": {
      "type": "object",
      "properties": { "type": { "const": "decision_matrix" }, "scoringMethod": { "const": "dimension_exact" }, "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimension" } } },
      "required": ["type", "scoringMethod", "dimensions"],
      "additionalProperties": false
    },
    "choiceSingleAnswer": {
      "type": "object",
      "properties": { "type": { "const": "choice_single" }, "optionId": { "$ref": "#/$defs/id" } },
      "required": ["type", "optionId"],
      "additionalProperties": false
    },
    "choiceMultipleAnswer": {
      "type": "object",
      "properties": { "type": { "const": "choice_multiple" }, "optionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } },
      "required": ["type", "optionIds"],
      "additionalProperties": false
    },
    "orderingAnswer": {
      "type": "object",
      "properties": { "type": { "const": "ordering" }, "orderedElementIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } } },
      "required": ["type", "orderedElementIds"],
      "additionalProperties": false
    },
    "selectedValueMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
    },
    "dimensionAnswer": {
      "type": "object",
      "properties": { "type": { "enum": ["complexity", "decision_matrix"] }, "selectedValueIdsByDimension": { "$ref": "#/$defs/selectedValueMap" } },
      "required": ["type", "selectedValueIdsByDimension"],
      "additionalProperties": false
    },
    "feedbackMessage": {
      "type": "object",
      "properties": { "kind": { "$ref": "#/$defs/id" }, "targetId": { "$ref": "#/$defs/id" }, "text": { "$ref": "#/$defs/learnerText" } },
      "required": ["kind", "targetId", "text"],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": { "type": { "enum": ["choice_single", "choice_multiple", "ordering", "complexity", "decision_matrix"] }, "reason": { "$ref": "#/$defs/learnerText" }, "details": { "$ref": "#/$defs/jsonValue" }, "messages": { "type": "array", "items": { "$ref": "#/$defs/feedbackMessage" } } },
      "required": ["type", "reason", "details"],
      "additionalProperties": false
    },
    "questionBase": {
      "type": "object",
      "properties": {
        "questionId": { "$ref": "#/$defs/id" },
        "trackId": { "$ref": "#/$defs/id" },
        "nodeId": { "$ref": "#/$defs/id" },
        "mentalUnitId": { "$ref": "#/$defs/id" },
        "prompt": { "$ref": "#/$defs/learnerText" },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/learnerText" } },
        "interaction": { "type": "object" },
        "answer": { "type": "object" },
        "feedback": { "$ref": "#/$defs/feedback" },
        "difficulty": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      },
      "required": ["questionId", "trackId", "nodeId", "mentalUnitId", "prompt", "interaction", "answer", "feedback", "difficulty"]
    },
    "choiceSingleQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        { "type": "object", "properties": { "interaction": { "$ref": "#/$defs/choiceSingleInteraction" }, "answer": { "$ref": "#/$defs/choiceSingleAnswer" }, "feedback": { "allOf": [{ "$ref": "#/$defs/feedback" }, { "properties": { "type": { "const": "choice_single" } } }] } } }
      ],
      "unevaluatedProperties": false
    },
    "choiceMultipleQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        { "type": "object", "properties": { "interaction": { "$ref": "#/$defs/choiceMultipleInteraction" }, "answer": { "$ref": "#/$defs/choiceMultipleAnswer" }, "feedback": { "allOf": [{ "$ref": "#/$defs/feedback" }, { "properties": { "type": { "const": "choice_multiple" } } }] } } }
      ],
      "unevaluatedProperties": false
    },
    "orderingQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        { "type": "object", "properties": { "interaction": { "$ref": "#/$defs/orderingInteraction" }, "answer": { "$ref": "#/$defs/orderingAnswer" }, "feedback": { "allOf": [{ "$ref": "#/$defs/feedback" }, { "properties": { "type": { "const": "ordering" } } }] } } }
      ],
      "unevaluatedProperties": false
    },
    "complexityQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        { "type": "object", "properties": { "interaction": { "$ref": "#/$defs/complexityInteraction" }, "answer": { "allOf": [{ "$ref": "#/$defs/dimensionAnswer" }, { "properties": { "type": { "const": "complexity" } } }] }, "feedback": { "allOf": [{ "$ref": "#/$defs/feedback" }, { "properties": { "type": { "const": "complexity" } } }] } } }
      ],
      "unevaluatedProperties": false
    },
    "decisionMatrixQuestion": {
      "allOf": [
        { "$ref": "#/$defs/questionBase" },
        { "type": "object", "properties": { "interaction": { "$ref": "#/$defs/decisionMatrixInteraction" }, "answer": { "allOf": [{ "$ref": "#/$defs/dimensionAnswer" }, { "properties": { "type": { "const": "decision_matrix" } } }] }, "feedback": { "allOf": [{ "$ref": "#/$defs/feedback" }, { "properties": { "type": { "const": "decision_matrix" } } }] } } }
      ],
      "unevaluatedProperties": false
    }
  }
}
