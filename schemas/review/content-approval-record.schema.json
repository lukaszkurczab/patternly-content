{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patternly-content-approval-record-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "candidateManifestPath",
    "candidateId",
    "trackId",
    "familyId",
    "source",
    "reviewPacket",
    "reviewer",
    "reviewDate",
    "reviewScope",
    "automatedChecks",
    "factualAndEditorialDefectsFound",
    "requiredCorrections",
    "acceptedLimitations",
    "finalDisposition"
  ],
  "properties": {
    "schemaVersion": { "const": "patternly-content-approval-v2" },
    "approvalId": { "type": "string", "minLength": 1 },
    "candidateManifestPath": { "const": "evidence/content-acceptance/candidate-manifest-v1.json" },
    "candidateId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trackId": { "type": "string", "minLength": 1 },
    "familyId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCommit", "sourceRoot", "sourceManifestSha256", "itemManifestSha256", "sourceFileCount", "canonicalItemCount"],
      "properties": {
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sourceRoot": { "type": "string", "minLength": 1 },
        "sourceManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "itemManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceFileCount": { "type": "integer", "minimum": 1 },
        "canonicalItemCount": { "type": "integer", "minimum": 1 }
      }
    },
    "reviewPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "candidateId", "sourceCommit", "sampleCount"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "candidateId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "sampleCount": { "type": "integer", "minimum": 1 }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "authorizationBasis"],
      "properties": {
        "kind": { "const": "owner_authorized_agent" },
        "id": { "type": "string", "minLength": 1 },
        "authorizationBasis": { "const": "explicit_user_authorization_in_active_task" }
      }
    },
    "reviewDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "reviewScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "automatedChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "result": { "const": "passed" }
        }
      }
    },
    "factualAndEditorialDefectsFound": { "type": "array", "items": { "type": "string" } },
    "requiredCorrections": { "type": "array", "items": { "type": "string" } },
    "acceptedLimitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "finalDisposition": { "const": "approved" }
  }
}
